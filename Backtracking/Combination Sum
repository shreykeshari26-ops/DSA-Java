class Solution {
    public void comb(int[] candidates, int target, int start, ArrayList<Integer> bl,  List<List<Integer>> ans ){
          if(target<0) return;
          if(target==0){
            ans.add(new ArrayList<>(bl));
            return;
        }
        for(int i=start; i<candidates.length;i++){
            bl.add(candidates[i]);
            
            comb(candidates, target-candidates[i],i,bl,ans);

            bl.remove(bl.size()-1);
            
        }



    }
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        ArrayList<Integer> bl =new ArrayList<>();
        List<List<Integer>> ans = new ArrayList<>();
        comb( candidates, target,0, bl, ans);

        return ans;
        
    }
}
