class Solution {

    public int findKthLargest(int[] nums, int k) {

        PriorityQueue<Integer> pq = new PriorityQueue<>();// min heap 

        for (int i = 0; i < nums.length; i++) {
            pq.add(nums[i]);
        }
        int ans = 0;
        for (int i = 0; i < nums.length - k + 1; i++) {
            ans = pq.poll();
        }

        return ans;
    }
}
