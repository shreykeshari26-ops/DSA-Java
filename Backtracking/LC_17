class Solution {

    String[] map = {
        "",     //0
        "",     //1
        "abc",  //2
        "def",  //3
        "ghi",  //4
        "jkl",  //5
        "mno",  //6
        "pqrs", //7
        "tuv",  //8
        "wxyz"  //9
    };

    public void letter(String digits, int idx, String curr, List<String> ans) {

        if (idx == digits.length()) {
            ans.add(curr);
            return;
        }

        String letters = map[digits.charAt(idx) - '0'];

        for (int i = 0; i < letters.length(); i++) {

            letter(digits, idx + 1, curr + letters.charAt(i),ans);
        }
    }

    public List<String> letterCombinations(String digits) {

        List<String> ans = new ArrayList<>();

        if (digits.length() == 0)
            return ans;

        letter(digits, 0, "", ans);

        return ans;
    }
}
