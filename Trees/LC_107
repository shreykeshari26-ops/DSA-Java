class Solution {
    public List<List<Integer>> levelOrderBottom(TreeNode root) {
        // create a list ans 
        List<List<Integer>> ans = new ArrayList<>();// list inside list see function and return type

        if (root == null)
            return ans;

        // for bfs make a queue
        Queue<TreeNode> q = new LinkedList<>();

        q.add(root); // add a root

        while(!q.isEmpty()){
            List<Integer> level = new ArrayList<>();

           int  size=q.size();
           
            for(int i=0; i<size; i++){
                TreeNode temp= q.remove(); // temp node 

                level.add(temp.val);

                if(temp.left!=null) q.add(temp.left);
                if(temp.right!=null) q.add(temp.right);



            }
          ans.add(level);

        }
        Collections.reverse(ans); // to revse the list 
        return ans;
        
    }
}
