class Solution {
   public void comb(int k, int n, int start,   ArrayList<Integer> bl, List<List<Integer>> ans){
       
        if(n==0 && bl.size()==k){
            ans.add(new ArrayList<>(bl));
            return;
        }
        if (n < 0 || bl.size() == k) {
            return;
        }
        for(int i=start;i<=9;i++){
             if (i > n)
                break;  
           
                bl.add(i);

                comb(k,n-i,i+1,bl,ans);

                bl.remove(bl.size()-1);
        
        }
    }
    public List<List<Integer>> combinationSum3(int k, int n) {
        List<List<Integer>> ans =  new ArrayList<>();
        ArrayList<Integer> bl = new ArrayList<>();
        comb(k, n,1, bl, ans);
        return ans;
        
    }
}
