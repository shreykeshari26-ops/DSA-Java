class Solution {
    public int findBottomLeftValue(TreeNode root) {
        
                if(root==null) return 0;

        Queue<TreeNode> q =new LinkedList<>();

        q.add(root);
      
       
       int no=0;

        while(!q.isEmpty()){
            int size = q.size();
             
            for(int i=0; i<size ; i++){
            TreeNode temp =q.remove();
             if (i == 0) { // left node
              no = temp.val;
            }
            
            



            if(temp.left!=null){
                q.add(temp.left);
            }
            if(temp.right!=null){
                q.add(temp.right);
            }
            }
           


        }
        return no ;
        
    }

    
}
