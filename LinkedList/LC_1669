class Solution {
    public ListNode mergeInBetween(ListNode list1, int a, int b, ListNode list2) {
        ListNode temp= list1;
        ListNode front =list1;
        ListNode curr = list1;
        ListNode last= list2;
        for(int i=0; i<a-1; i++){
            temp= temp.next;
            
        }
        
        for( int i=0; i<=b; i++){
            curr=curr.next;

        }
        while(last.next!=null){
            last=last.next;
            

        }
        temp.next=list2;
        last.next=curr;
        return front;

        
    }
}
