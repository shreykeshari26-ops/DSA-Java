class Solution {
    public int maxDepth(String s) {
        int depth=0;
        int depthmax=0;
        Stack<Character> br = new Stack<>();
        
        for(int i=0; i<s.length();i++){
            char ch = s.charAt(i);
            if(ch=='('){
                br.push(ch);
                depth++;
            }
            if(ch==')'){
                br.pop();
                depth--;
            }
            depthmax= Math.max(depth, depthmax);

        }
        return depthmax;

    }
}
