class Solution {
    public int deepestLeavesSum(TreeNode root) {
        if(root==null) return 0;

        Queue<TreeNode> q =new LinkedList<>();

        q.add(root);
       int sum=0;

        while(!q.isEmpty()){
            int size = q.size();
             sum=0;
            

            for(int i=0; i<size ; i++){
            TreeNode temp =q.remove();
        
            sum+=temp.val;
            



            if(temp.left!=null){
                q.add(temp.left);
            }
            if(temp.right!=null){
                q.add(temp.right);
            }

            }


        }
        return sum;
        
    }
}
